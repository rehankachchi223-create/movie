# ==============================================================================
# Database Configuration
# ==============================================================================
# Local Development default (SQLite file):
DATABASE_URL=sqlite:///./movierec.db

# Docker / Production (PostgreSQL connection):
# DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password@localhost:5432/movierec
# When running with Docker Compose, the backend container automatically connects
# to the PostgreSQL service ('db') using POSTGRES_USER and POSTGRES_PASSWORD below.

# Docker PostgreSQL Credentials (REQUIRED for Docker Compose):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=movierec

# ==============================================================================
# Security & JWT Authentication
# ==============================================================================
# Generate a strong 256-bit random secret:
# python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: In production, SECRET_KEY must be a strong random secret and cannot use default placeholders!
SECRET_KEY=generate_a_secure_random_secret_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# External Movie Provider API (Optional TMDB integration)
# ==============================================================================
EXTERNAL_MOVIE_API_KEY=
TMDB_API_KEY=

# Movie catalog import settings
MOVIE_IMPORT_PAGE_LIMIT=10
MOVIE_IMPORT_MAX_MOVIES=500
MOVIE_IMPORT_MINIMUM_COUNT=200
MOVIE_IMPORT_START_YEAR=1900
MOVIE_IMPORT_END_YEAR=2026

# ==============================================================================
# Application & Environment Settings
# ==============================================================================
PROJECT_NAME=Movie Recommendation Platform
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==============================================================================
# CORS Configuration (Allowed origins for frontend)
# ==============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://127.0.0.1:3000","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# ==============================================================================
# Redis Cache Configuration (Optional)
# ==============================================================================
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS_CACHE=false
