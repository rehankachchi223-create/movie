rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Movie catalog & genres: Public read access
    match /movies/{movieId} {
      allow read: if true;
      allow write: if false;
    }

    match /genres/{genreId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles: Only the owner can read/write their document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User subcollections (favorites, watchlist, ratings, history)
      match /favorites/{movieId} {
        allow read, write: if isOwner(userId);
      }

      match /watchlist/{movieId} {
        allow read, write: if isOwner(userId);
      }

      match /ratings/{movieId} {
        allow read, write: if isOwner(userId);
      }

      match /history/{movieId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
